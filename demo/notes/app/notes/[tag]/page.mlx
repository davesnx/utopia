open Notes_data

let before _request = ()

let metadata params =
  let tag_slug = List.assoc_opt "tag" params |> Option.value ~default:"" in
  match tag_summary_opt tag_slug with
  | Some summary ->
      Utopia.Metadata.make
        ~title:(summary.name ^ " \xe2\x80\x94 Notes")
        ?description:summary.description ()
  | None -> Utopia.Metadata.make ~title:"Tag" ()

let react_array items = React.array (Array.of_list items)

module Navigate = Utopia.Router.Link

let[@react.server.function] toggle_note_checklist_item_action ~(slug : string)
    ~(item_index : string) =
  (Js.Promise.resolve
     (toggle_note_checklist_item slug
        (int_of_string_opt item_index |> Option.value ~default:(-1)))
    : Utopia.Route.t Js.Promise.t)

let note_data_of_note (note : note) =
  ( note.summary.slug,
    note.summary.tag_slug,
    note.summary.title,
    note.summary.preview,
    note.summary.updated_at,
    render_note_body_html note.body,
    List.map
      (fun (item : checklist_item) -> (item.text, item.done_))
      note.checklist )

let tag_data_of_summary (summary : tag_summary) = (summary.slug, summary.name)

let current_tag_slug path =
  match
    path |> String.split_on_char '/'
    |> List.filter (fun segment -> segment <> "")
  with
  | [ "notes"; tag_slug ] when tag_slug <> "new" -> Some tag_slug
  | _ -> None

let scroll_container_class =
  "min-h-screen overflow-y-auto [scrollbar-width:thin] \
   [scrollbar-color:rgb(140_118_79_/_35%)_transparent] \
   [&::-webkit-scrollbar]:h-[10px] [&::-webkit-scrollbar]:w-[10px] \
   [&::-webkit-scrollbar-track]:bg-transparent \
   [&::-webkit-scrollbar-thumb]:border-2 \
   [&::-webkit-scrollbar-thumb]:border-transparent \
   [&::-webkit-scrollbar-thumb]:bg-[rgb(140_118_79_/_28%)] \
   [&::-webkit-scrollbar-thumb]:bg-clip-padding"

let note_body_class =
  "mt-8 text-[17px] leading-8 text-[#232320] [&_p+p]:mt-4 [&_ul]:mt-4 \
   [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 \
   [&_li+li]:mt-[0.35rem] [&_strong]:font-semibold [&_em]:italic \
   [&_a]:text-[#8a5a18] [&_a]:underline [&_a]:underline-offset-4 \
   [&_blockquote]:mt-5 [&_blockquote]:border-l-2 \
   [&_blockquote]:border-[#ded7c8] [&_blockquote]:pl-4 \
   [&_blockquote]:text-[#5d5c57] [&_h1]:mt-8 [&_h1]:text-[28px] \
   [&_h1]:font-semibold [&_h1]:tracking-[-0.03em] [&_h2]:mt-7 \
   [&_h2]:text-[24px] [&_h2]:font-semibold [&_h2]:tracking-[-0.03em] \
   [&_h3]:mt-6 [&_h3]:text-[20px] [&_h3]:font-semibold \
   [&_pre.utopia-markdown-code-block]:mt-6 \
   [&_pre.utopia-markdown-code-block]:mb-4 \
   [&_pre.utopia-markdown-code-block]:overflow-x-auto \
   [&_pre.utopia-markdown-code-block]:px-5 \
   [&_pre.utopia-markdown-code-block]:py-4 \
   [&_pre.utopia-markdown-code-block]:text-[14px] \
   [&_pre.utopia-markdown-code-block]:leading-7 \
   [&_pre.utopia-markdown-code-block]:shadow-[inset_0_0_0_1px_rgb(24_24_23_/_0.08)] \
   [&_pre.utopia-markdown-code-block_code]:grid \
   [&_pre.utopia-markdown-code-block_.line]:min-h-[1.6em] \
   [&_code.utopia-inline-code]:bg-[#f1ece0] [&_code.utopia-inline-code]:px-1.5 \
   [&_code.utopia-inline-code]:py-[0.18rem] \
   [&_code.utopia-inline-code]:text-[0.9em] \
   [&_code.utopia-inline-code]:font-medium \
   [&_code.utopia-inline-code]:text-[#7f4f14]"

module Note_header = struct
  let[@react.client.component] make ~(title : string) ~(preview : string)
      ~(updated_at : string) () =
    <header className="border-b border-[#e4e2db] pb-6">
      <div
        className="flex flex-wrap items-center gap-2 text-[12px] text-[#8a8984]">
        <span>(React.string (time_only updated_at))</span>
      </div>
      <h1
        className="mt-3 text-[34px] font-semibold tracking-[-0.04em] \
                   text-[#1d1d1f] sm:text-[42px]">
        (React.string title)
      </h1>
      <p className="mt-3 max-w-[42rem] text-[15px] leading-7 text-[#5d5c57]">
        (React.string preview)
      </p>
    </header>
end

module Note_body = struct
  let[@react.client.component] make ~(body_html : string) () =
    <div
      className=note_body_class
      dangerouslySetInnerHTML=[%mel.obj { __html = body_html }]
    />
end

module Checklist = struct
  let[@react.client.component] make ~(slug : string)
      ~(items : (string * bool) list) () =
    if items = [] then React.null
    else
      let router = Utopia.useRouter () in
      let pending_item, set_pending_item =
        React.useState (fun () -> (None : int option))
      in
      let save_error, set_save_error = React.useState (fun () -> "") in
      let on_toggle item_index _event =
        if Option.is_some pending_item then ()
        else (
          set_pending_item (fun _ -> Some item_index);
          set_save_error (fun _ -> "");
          let request =
            toggle_note_checklist_item_action.call ~slug
              ~item_index:(string_of_int item_index)
            |> Js.Promise.then_ (fun route ->
                set_pending_item (fun _ -> None);
                router.navigate ~history:Utopia.Replace
                  ~freshness:Utopia.Revalidate route;
                Js.Promise.resolve ())
            |> Js.Promise.catch (fun _error ->
                set_pending_item (fun _ -> None);
                set_save_error (fun _ -> "Unable to update the checklist item.");
                Js.Promise.resolve ())
          in
          ignore request)
      in
      <section className="mt-10 pt-6">
        <p
          className="text-[11px] font-medium uppercase tracking-[0.18em] \
                     text-[#8a8984]">
          (React.string "Checklist")
        </p>
        (if save_error = "" then React.null
         else
           <p className="mt-3 text-[12px] text-[#b42318]">
             (React.string save_error)
           </p>)
        <div
          className="mt-4 border-y border-[#ebe9e2] divide-y divide-[#ebe9e2]">
          (react_array
             (List.mapi
                (fun item_index (item_text, item_done) ->
                  let is_pending = pending_item = Some item_index in
                  let marker_class =
                    if item_done then
                      "mt-[6px] h-3 w-3 shrink-0 border border-[#9f9e98] \
                       bg-[#9f9e98] transition-colors hover:border-[#8f8e89] \
                       hover:bg-[#8f8e89] disabled:cursor-default"
                    else
                      "mt-[6px] h-3 w-3 shrink-0 border border-[#c6c5bf] \
                       bg-transparent transition-colors hover:border-[#9f9e98] \
                       hover:bg-[#f1f0ea] disabled:cursor-default"
                  in
                  let marker_class =
                    if is_pending then marker_class ^ " opacity-60"
                    else marker_class
                  in
                  let text_class =
                    if is_pending && item_done then
                      "text-[15px] leading-7 text-[#8a8984] line-through \
                       opacity-70"
                    else if is_pending then
                      "text-[15px] leading-7 text-[#232320] opacity-70"
                    else if item_done then
                      "text-[15px] leading-7 text-[#8a8984] line-through"
                    else "text-[15px] leading-7 text-[#232320]"
                  in
                  <div
                    key=(slug ^ ":" ^ string_of_int item_index)
                    className="flex items-start gap-3 py-3">
                    <button
                      type_="button"
                      disabled=(Option.is_some pending_item)
                      onClick=(on_toggle item_index)
                      className=marker_class
                    />
                    <p className=text_class>(React.string item_text)</p>
                  </div>)
                items))
        </div>
      </section>
end

module Note_article = struct
  let[@react.client.component] make ~(slug : string) ~(title : string)
      ~(preview : string) ~(updated_at : string) ~(body_html : string)
      ~(checklist : (string * bool) list) () =
    <article className="border-b border-[#e4e2db] px-6 py-8 sm:px-8 sm:py-10">
      <Note_header title preview updated_at />
      <Note_body body_html />
      <Checklist slug items=checklist />
    </article>
end

module Tag_page = struct
  let find_summary summaries slug =
    summaries
    |> List.find_opt (fun (candidate_slug, _name) ->
        String.equal candidate_slug slug)

  let notes_for_summary notes tag_slug =
    notes
    |> List.filter
         (fun
           ( _slug,
             candidate_tag_slug,
             _title,
             _preview,
             _updated_at,
             _body_html,
             _checklist )
         -> String.equal candidate_tag_slug tag_slug)

  let[@react.client.component] make ~(tag_summaries : (string * string) list)
      ~(notes :
         (string
         * string
         * string
         * string
         * string
         * string
         * (string * bool) list)
         list) () =
    let router = Utopia.useRouter () in
    match current_tag_slug router.path with
    | None -> React.null
    | Some tag_slug -> (
        match find_summary tag_summaries tag_slug with
        | None ->
            <main className=scroll_container_class>
              <header className="border-b border-[#e4e2db] px-6 py-5 sm:px-8">
                <p
                  className="text-[11px] font-medium uppercase \
                             tracking-[0.18em] text-[#8a8984]">
                  (React.string "Tag")
                </p>
                <h2
                  className="mt-2 text-[30px] font-semibold tracking-[-0.03em] \
                             text-[#1d1d1f]">
                  (React.string "Unknown Tag")
                </h2>
                <p
                  className="mt-3 max-w-[34rem] text-[15px] leading-7 \
                             text-[#5d5c57]">
                  (React.string
                     "Choose a tag from the sidebar or create a new one above \
                      the list.")
                </p>
              </header>
            </main>
        | Some (_slug, name) ->
            let tag_notes = notes_for_summary notes tag_slug in
            <main className=scroll_container_class>
              <header className="border-b border-[#e4e2db] px-6 py-5 sm:px-8">
                <div>
                  <p
                    className="text-[11px] font-medium uppercase \
                               tracking-[0.18em] text-[#8a8984]">
                    (React.string "Tag")
                  </p>
                  <h2
                    className="mt-2 text-[30px] font-semibold \
                               tracking-[-0.03em] text-[#1d1d1f]">
                    (React.string name)
                  </h2>
                </div>
              </header>
              (if tag_notes = [] then
                 <section className="px-6 py-10 sm:px-8">
                   <p className="text-[15px] leading-7 text-[#5d5c57]">
                     (React.string "There are no notes in this tag yet.")
                   </p>
                 </section>
               else
                 react_array
                   (List.map
                      (fun ( slug,
                             _tag_slug,
                             title,
                             preview,
                             updated_at,
                             body_html,
                             checklist ) ->
                        <Note_article
                          key=slug
                          slug
                          title
                          preview
                          updated_at
                          body_html
                          checklist
                        />)
                      tag_notes))
            </main>)
end

let[@react.component] make () =
  let tag_views = tag_summaries () |> List.map tag_data_of_summary in
  let notes =
    tag_summaries ()
    |> List.map (fun summary -> notes_for_tag summary.slug)
    |> List.flatten |> List.map note_data_of_note
  in
  <Tag_page tag_summaries=tag_views notes />
