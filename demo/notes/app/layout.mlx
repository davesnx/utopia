let[@react.component] make ~(children : React.element) () =
  <div
    className="min-h-screen bg-[#f5f5f3] text-[#1d1d1f] antialiased \
               selection:bg-[#e2ddd1] [color-scheme:light] \
               [text-rendering:optimizeLegibility] \
               [font-family:-apple-system,BlinkMacSystemFont,'SF_Pro_Text','Helvetica_Neue',sans-serif]">
    children
  </div>
