let metadata _params =
  Utopia.Metadata.make ~title:"Posts" ~description:"All blog posts." ()

let[@react.component] make () =
  <div>
    <h1 className="font-semibold text-slate-800 text-balance mb-7">
      (React.string "Posts")
    </h1>
    <ul>
      (Blog_data.posts
      |> List.map (fun (post : Blog_data.post) ->
          <li key=post.slug>
            <Utopia.Router.Link
              to_=(Routes.Posts.Param_slug.make ~slug:post.slug ())
              className="group flex gap-1 -mx-2 px-2 justify-between \
                         items-center font-medium">
              <span
                className="block text-slate-600 group-hover:text-slate-800 \
                           transition-colors">
                (React.string post.title)
              </span>
              <Date value=post.date />
            </Utopia.Router.Link>
          </li>)
      |> Array.of_list |> React.array)
    </ul>
  </div>
